# Copy this file to .env and update the local MySQL password before starting.
SERVER_PORT=10202
DB_URL=jdbc:mysql://127.0.0.1:3306/user_auth?useSSL=false&serverTimezone=UTC&characterEncoding=UTF-8&useUnicode=true
DB_USERNAME=root
DB_PASSWORD=change-me

# Relative to the demo directory when using scripts/start-backend.sh.
UPLOAD_PATH=./src/main/resources/static/images
UPLOADS_PATH=./src/main/resources/static/uploads
