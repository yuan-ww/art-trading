# Copy this file to .env and update the local MySQL password before starting.
SERVER_PORT=10202
DB_URL="jdbc:mysql://127.0.0.1:3306/user_auth?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8&useUnicode=true"
DB_USERNAME=root
DB_PASSWORD=change-me

# Relative to the demo directory when using scripts/start-backend.sh.
UPLOAD_PATH=./data/images
UPLOADS_PATH=./data/uploads
CORS_ALLOWED_ORIGIN=http://localhost:8080
PUBLIC_BASE_URL=http://localhost:10202

# Keep this true for normal runtime. It settles expired auctions and cancels timed-out pending orders.
# Set it to false when inspecting a historical database.
APP_AUCTION_SCHEDULER_ENABLED=true

# Use validate for an existing database when you do not want Hibernate to change tables.
JPA_DDL_AUTO=update
